# Backend environment example (VYRO VX7 — Smart Business POS API)
# Real MongoDB connection — local mongod, or a MongoDB Atlas cluster connection string
# (mongodb+srv://user:pass@cluster.mongodb.net) for production.
MONGO_URL=mongodb://localhost:27017
DB_NAME=vyro_vx7
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-strong-password
CORS_ORIGINS=https://your-vercel-app.vercel.app

# Firebase project ID (Google Sign-In). Must match REACT_APP_FIREBASE_PROJECT_ID
# in the frontend .env — the backend verifies Google ID tokens against this project.
# Firebase Console -> Project settings -> General -> Project ID.
FIREBASE_PROJECT_ID=your-project-id
