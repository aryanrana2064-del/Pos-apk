# Frontend environment example (VYRO VX7)
# Copy this file to .env and fill in real values. Never commit the real .env.

# Your FastAPI backend URL (no trailing slash), e.g. http://localhost:8001 in dev
REACT_APP_BACKEND_URL=http://localhost:8001

# Firebase project config for Google Sign-In.
# Get these from: https://console.firebase.google.com -> your project ->
# Project settings (gear icon) -> General -> "Your apps" -> Web app (</>) -> SDK setup and config.
# Also enable it: Authentication -> Sign-in method -> Google -> Enable.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
